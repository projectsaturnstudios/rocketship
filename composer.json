{
    "name": "projectsaturnstudios/rocketship",
    "description": "Drop-in replacement for Laravel Octane, with a native server on epoll/kqueue: no Swoole, no Go binary.",
    "keywords": [
        "laravel",
        "octane",
        "native",
        "epoll",
        "kqueue",
        "swoole",
        "roadrunner",
        "frankenphp"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/projectsaturnstudios/rocketship/issues",
        "source": "https://github.com/projectsaturnstudios/rocketship"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original author of Laravel Octane"
        }
    ],
    "require": {
        "php": "~8.4.27 || ^8.5.12",
        "laminas/laminas-diactoros": "^3.0",
        "laravel/framework": "^10.10.1|^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.1.24|^0.2.0|^0.3.0",
        "laravel/serializable-closure": "^1.3|^2.0",
        "nesbot/carbon": "^2.66.0|^3.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/psr-http-message-bridge": "^2.2.0|^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.6.1",
        "inertiajs/inertia-laravel": "^1.3.2|^2.0",
        "laravel/scout": "^10.2.1",
        "laravel/socialite": "^5.6.1",
        "livewire/livewire": "^4.4.7",
        "nunomaduro/collision": "^6.4.0|^7.5.2|^8.0",
        "orchestra/testbench": "^8.21|^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1.7",
        "phpunit/phpunit": "^10.4|^11.5|^12.0|^13.0",
        "spiral/roadrunner-cli": "^2.6.0",
        "spiral/roadrunner-http": "^3.3.0"
    },
    "suggest": {
        "ext-pcntl": "Native server: supervises its workers. Required by the native server in both modes.",
        "ext-posix": "Native server: required in both modes.",
        "ext-epoll": "Native server on Linux: pie install php-io-extensions/epoll",
        "ext-kqueue": "Native server on macOS: pie install php-io-extensions/kqueue",
        "ext-posi": "Native server: pie install php-io-extensions/posi (0.10.6 or later). Linux needs it in both modes; threads mode needs it everywhere.",
        "ext-parallel": "Native server threads mode, on a ZTS PHP.",
        "ext-swoole": "Octane's Swoole server."
    },
    "bin": [
        "bin/roadrunner-worker",
        "bin/swoole-server"
    ],
    "conflict": {
        "laravel/octane": "*",
        "spiral/roadrunner": "<2023.1.0",
        "spiral/roadrunner-cli": "<2.6.0",
        "spiral/roadrunner-http": "<3.3.0"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Octane\\": "src",
            "ProjectSaturnStudios\\Rocketship\\": "rocketship/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\Octane\\Tests\\": "tests",
            "ProjectSaturnStudios\\Rocketship\\Tests\\": "tests/Rocketship/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:sync-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "test": [
            "@php vendor/bin/testbench package:sync-skeleton --ansi",
            "@php vendor/bin/pest",
            "@php vendor/bin/pest --testsuite=Rocketship"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "laravel": {
            "providers": [
                "Laravel\\Octane\\OctaneServiceProvider"
            ],
            "aliases": {
                "Octane": "Laravel\\Octane\\Facades\\Octane"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
